# Docker ignore file
# Exclude unnecessary files from Docker build context

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.iml

# Build artifacts (except target JAR)
target/classes
target/test-classes
target/generated-sources
target/generated-test-sources
target/maven-status
target/surefire-reports

# Test files
src/test

# Documentation
docs
*.md
!README.md

# CDC 输出数据（近 1GB，镜像构建不需要，排除以加快上下文传输）
# 注意：不要排除 cache/（内含预下载的 Flink tarball，Dockerfile COPY 需要）
output/
data/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Kiro specs
.kiro

apiVersion: v1
kind: Secret
metadata:
  name: flink-secrets
  namespace: flink
type: Opaque
stringData:
  # ── CDC 管理库（OceanBase，MySQL 兼容协议）────────────────────────
  # 存储 CDC_DATASOURCES / CDC_TASKS / RUNTIME_JOBS / APP_CONFIG 等元数据表
  cdc-admin-type: "OCEANBASE_ORACLE"           # MYSQL（OceanBase）/ ORACLE / POSTGRES / OCEANBASE_ORACLE
  # 本地/Docker Desktop：host.docker.internal；生产改为真实 OB 地址
  cdc-admin-host: "your-ob-host"
  cdc-admin-port: "2881"
  cdc-admin-username: "cdc_admin@oratenant"
  cdc-admin-password: "your-cdc-admin-password-here"
  cdc-admin-database: "CDC_ADMIN"

  # ── 安全配置 ─────────────────────────────────────────────────────
  jwt-secret: "your-jwt-secret-here-min-32-chars"
  aes-encryption-key: "your-aes-key-here"
  admin-initial-password: "Admin2026Secure"

  # ── 阿里云 OSS（checkpoint / savepoint / CSV 输出统一存储，替代 PVC）──
  # 复制本文件为 flink-secrets.yaml 后填入真实值（该文件已 gitignore）
  # endpoint 可带或不带 https://，entrypoint 会自动去掉协议前缀
  oss-endpoint: "https://oss-cn-shanghai.aliyuncs.com"
  oss-access-key-id: "your-oss-access-key-id"
  oss-access-key-secret: "your-oss-access-key-secret"
  oss-bucket: "your-bucket-name"
  # 对象前缀，建议以 / 结尾（可留空字符串）。最终路径如：
  #   oss://<bucket>/<prefix>flink/checkpoints
  #   oss://<bucket>/<prefix>cdc
  oss-prefix: "data-pipeline/"

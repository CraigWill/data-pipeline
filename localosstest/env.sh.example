#!/bin/bash
# 本地 Flink + OSS 联调环境变量
# 用法: cp env.sh.example env.sh && vim env.sh

# ============================================
# Flink（本机安装）
# ============================================
export FLINK_HOME="${FLINK_HOME:-/usr/local/flink-1.20.0}"

# 使用独立端口，避免和 Kind port-forward 的 8081 冲突
export REST_PORT=18081
export RPC_PORT=16123

# ============================================
# 阿里云 OSS（必填）
# ============================================
export OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
export OSS_ACCESS_KEY_ID=your-access-key-id
export OSS_ACCESS_KEY_SECRET=your-access-key-secret
export OSS_BUCKET_NAME=your-bucket

# 对象前缀，建议以 / 结尾；最终路径见下方派生变量
export OSS_PREFIX=localosstest/

# ============================================
# 派生路径（一般不用改）
# ============================================
export CHECKPOINT_DIR="oss://${OSS_BUCKET_NAME}/${OSS_PREFIX}flink/checkpoints"
export SAVEPOINT_DIR="oss://${OSS_BUCKET_NAME}/${OSS_PREFIX}flink/savepoints"
export OUTPUT_PATH="oss://${OSS_BUCKET_NAME}/${OSS_PREFIX}out"

# Checkpoint 间隔（毫秒）
export CHECKPOINT_INTERVAL_MS=10000

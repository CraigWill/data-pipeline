apiVersion: v1
kind: Secret
metadata:
  name: flink-secrets
  namespace: flink
type: Opaque
stringData:
  # ── CDC 管理库（OceanBase，MySQL 兼容协议）────────────────────────
  # 存储 CDC_DATASOURCES / CDC_TASKS / RUNTIME_JOBS / APP_CONFIG 等元数据表
  cdc-admin-host: "your-ob-host"
  cdc-admin-port: "2881"            # OceanBase MySQL 兼容端口默认 2881
  cdc-admin-username: "cdc_admin"
  cdc-admin-password: "your-cdc-admin-password-here"
  cdc-admin-database: "cdc_admin"   # OceanBase 使用 database 名，不用 SID

  # ── 安全配置 ─────────────────────────────────────────────────────
  jwt-secret: "your-jwt-secret-here-min-32-chars"
  aes-encryption-key: "your-aes-key-here-16-chars"
  admin-initial-password: "Admin2026Secure"
